# Copy to infra/cluster.env (git-ignored), fill in, then run infra/render-config.sh.

# Region and subnets must be in an availability zone that offers hpc7g.16xlarge;
# see "Pick an availability zone" in infra/README.md.
AWS_REGION=us-east-1
HEAD_SUBNET_ID=subnet-0123456789abcdef0     # public subnet (head node needs SSH from you)
COMPUTE_SUBNET_ID=subnet-0fedcba9876543210  # private subnet with a NAT gateway, same AZ

# Existing EC2 key pair in AWS_REGION
SSH_KEY_NAME=dgemm-key

# Who may SSH to the head node: your public IP as /32 (curl -s https://checkip.amazonaws.com)
ALLOWED_CIDR=203.0.113.7/32

# Upper bound on compute nodes; must fit your hpc7g vCPU quota (64 vCPUs per node)
MAX_NODES=16
